# Copy to site.env and fill in; scripts/env.sh sources it. site.env is never committed.
export MIDTRAIN_DATA=/path/to/midtrain_data            # large data: pool, tokens, evaluation items, runs
export MIDTRAIN_MODELS=/path/to/base_models            # folders qwen35_0.8B_base, qwen35_2B_base, qwen35_4B_base, qwen35_9B_base
export MIDTRAIN_TOKENIZER=$MIDTRAIN_MODELS/qwen35_0.8B_base
export MIDTRAIN_PYTHON=/path/to/env/bin/python          # torch, transformers, vllm, pyarrow, scikit-learn, zstandard
export MIDTRAIN_TEACHER=/path/to/teacher_model         # the model that writes the synthetic data
# only on the workstation, for scripts/cluster/sync.sh:
export MIDTRAIN_CLUSTER_HOST=cluster.example.org
export MIDTRAIN_CLUSTER_RSYNC_SHELL="ssh"              # for example "ssh -o ControlPath=$HOME/.ssh/socket"
export MIDTRAIN_CLUSTER_ROOT=/path/on/cluster/qwen_midtrain
export MIDTRAIN_CLUSTER_DATA=/path/on/cluster/midtrain_data
export MIDTRAIN_CLUSTER_MODELS=/path/on/cluster/base_models
# only where model-written code cannot run under bubblewrap: an apptainer image for the sandbox (eval_tasks.py)
# export MIDTRAIN_SANDBOX_IMAGE=/path/to/sandbox.sif
